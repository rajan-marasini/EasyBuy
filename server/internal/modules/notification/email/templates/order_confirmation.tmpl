<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmation - EasyBuy</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f9fafb; color: #1f2937;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 650px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
        <!-- Header -->
        <tr>
            <td style="padding: 40px 30px; text-align: center; background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 700; letter-spacing: -0.025em;">EasyBuy</h1>
                <p style="margin: 10px 0 0; color: #d1fae5; font-size: 16px;">Order Confirmation</p>
            </td>
        </tr>
        <!-- Content -->
        <tr>
            <td style="padding: 40px 30px;">
                <h2 style="margin: 0 0 20px; font-size: 24px; font-weight: 600; color: #111827;">Hello {{.Name}},</h2>
                <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #4b5563;">
                    Thank you for your order! Your order has been successfully placed and is currently being processed. Here are your order details:
                </p>
                
                <div style="background-color: #f8fafc; border-radius: 8px; padding: 20px; margin-bottom: 30px;">
                    <p style="margin: 0; font-size: 14px; color: #64748b;">Order ID:</p>
                    <p style="margin: 4px 0 0; font-size: 18px; font-weight: 700; color: #0f172a;">#{{.OrderID}}</p>
                </div>

                <h3 style="margin: 0 0 16px; font-size: 18px; font-weight: 600; color: #334155; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px;">Order Summary</h3>
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-bottom: 24px;">
                    <thead>
                        <tr>
                            <th align="left" style="padding: 12px 0; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 14px; font-variant: all-small-caps;">Product</th>
                            <th align="center" style="padding: 12px 0; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 14px; font-variant: all-small-caps;">Qty</th>
                            <th align="right" style="padding: 12px 0; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 14px; font-variant: all-small-caps;">Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{range .Items}}
                        <tr>
                            <td style="padding: 16px 0; border-bottom: 1px solid #f1f5f9; vertical-align: top;">
                                <p style="margin: 0; font-size: 15px; font-weight: 500; color: #1e293b;">{{.ProductName}}</p>
                            </td>
                            <td align="center" style="padding: 16px 0; border-bottom: 1px solid #f1f5f9; vertical-align: top; color: #475569; font-size: 15px;">
                                {{.Quantity}}
                            </td>
                            <td align="right" style="padding: 16px 0; border-bottom: 1px solid #f1f5f9; vertical-align: top; color: #1e293b; font-size: 15px; font-weight: 600;">
                                Rs.{{printf "%.2f" .Subtotal}}
                            </td>
                        </tr>
                        {{end}}
                    </tbody>
                </table>
                
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8fafc; border-radius: 8px;">
                    <tr>
                        <td align="right" style="padding: 20px; font-size: 18px; font-weight: 700; color: #1e293b;">
                            <span style="color: #64748b; font-weight: 400; font-size: 16px; margin-right: 12px;">Total Amount:</span>
                            Rs.{{.TotalAmount}}
                        </td>
                    </tr>
                </table>

                <div style="margin-top: 40px;">
                    <h3 style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #334155;">Shipping Address</h3>
                    <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4b5563; padding: 16px; background-color: #f1f5f9; border-radius: 8px;">
                        {{.ShippingAddress}}
                    </p>
                </div>
                
                <p style="margin: 30px 0 0; font-size: 15px; color: #64748b; text-align: center;">
                    We'll notify you when your order ships.
                </p>
            </td>
        </tr>
        <!-- Footer -->
        <tr>
            <td style="padding: 30px; background-color: #f3f4f6; text-align: center;">
                <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280;">&copy; 2026 EasyBuy Inc. All rights reserved.</p>
                <p style="margin: 0; font-size: 12px; color: #9ca3af;">
                    123 Commerce St, Kathmandu, Nepal
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
