<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email - EasyBuy</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f9fafb; color: #1f2937;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 20px auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
        <!-- Header -->
        <tr>
            <td style="padding: 40px 0; text-align: center; background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);">
                <h1 style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 700; letter-spacing: -0.025em;">EasyBuy</h1>
            </td>
        </tr>
        <!-- Content -->
        <tr>
            <td style="padding: 40px 30px;">
                <h2 style="margin: 0 0 20px; font-size: 24px; font-weight: 600; color: #111827;">Welcome, {{.Name}}!</h2>
                <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #4b5563;">
                    We're excited to have you on board! To get started with your EasyBuy account, please verify your email address by clicking the button below.
                </p>
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tr>
                        <td align="center" style="padding: 10px 0;">
                            <a href="{{.EmailVerificationLink}}" target="_blank" style="display: inline-block; padding: 14px 32px; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; background-color: #6366f1; border-radius: 8px; transition: background-color 0.2s;">
                                Verify Email Address
                            </a>
                        </td>
                    </tr>
                </table>
                <p style="margin: 30px 0 0; font-size: 14px; line-height: 1.5; color: #6b7280;">
                    Or copy and paste this link into your browser:<br>
                    <a href="{{.EmailVerificationLink}}" style="color: #6366f1; word-break: break-all;">{{.EmailVerificationLink}}</a>
                </p>
                <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid #e5e7eb;">
                    <p style="margin: 0; font-size: 14px; color: #9ca3af;">
                        This link will expire in 24 hours. If you did not create an account, you can safely ignore this email.
                    </p>
                </div>
            </td>
        </tr>
        <!-- Footer -->
        <tr>
            <td style="padding: 30px; background-color: #f3f4f6; text-align: center;">
                <p style="margin: 0 0 8px; font-size: 14px; color: #6b7280;">&copy; 2026 EasyBuy Inc. All rights reserved.</p>
                <p style="margin: 0; font-size: 12px; color: #9ca3af;">
                    123 Commerce St, Kathmandu, Nepal
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
